<?xml version="1.0" encoding="utf-8"?>
<!-- Two stacked bars: green normally, red when low. The app code toggles which one shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="6dp">

    <ProgressBar
        android:id="@+id/w_battery_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progress="0"
        android:progressDrawable="@drawable/bar_battery" />

    <ProgressBar
        android:id="@+id/w_battery_bar_low"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progress="0"
        android:progressDrawable="@drawable/bar_low"
        android:visibility="gone" />
</FrameLayout>
