<?xml version="1.0" encoding="utf-8"?>
<!--
  Tall widget, minimal redesign. Same size as before, no dividers, one accent colour:
  top    = battery (big, light) with temperature; RAM and storage as thin bars
  middle = refresh rate, CPU (temp, clock) and GPU (temp), LEDs beside CPU and GPU
  bottom = current, voltage, battery capacity (health and cycles underneath)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_minimal"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: battery -->
        <LinearLayout
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_led_batt"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/led_off" />
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="BATTERY"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
            <TextView
                android:id="@+id/w_charging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:text="⚡"
                android:textColor="@color/c_battery"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                android:id="@+id/w_battery_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="--%"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

                <TextView
                android:id="@+id/w_batt_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                android:text="-- °C"
                android:textColor="@color/text_label"
                android:textSize="12sp" />
            </LinearLayout>

            <include
                layout="@layout/part_battery_bar_thin"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Right: RAM and storage -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="RAM"
                    android:textColor="@color/text_label"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/w_ram_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="--%"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/w_ram_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="0"
                android:progressDrawable="@drawable/bar_thin_white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="Storage"
                    android:textColor="@color/text_label"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/w_sto_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="--%"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/w_sto_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="0"
                android:progressDrawable="@drawable/bar_thin_white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle: refresh rate, CPU, GPU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="REFRESH"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
        </LinearLayout>
            <TextView
            android:id="@+id/w_hz_cpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:text="-- Hz"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_led_cpu"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/led_off" />
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="CPU"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
        </LinearLayout>
            <TextView
            android:id="@+id/w_cpu_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_led_gpu"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/led_off" />
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="GPU"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
        </LinearLayout>
            <TextView
            android:id="@+id/w_gpu_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: current, voltage, capacity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="CURRENT"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
        </LinearLayout>
            <TextView
            android:id="@+id/w_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="VOLTAGE"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
        </LinearLayout>
            <TextView
            android:id="@+id/w_voltage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="CAPACITY"
            android:textColor="@color/text_label"
            android:textSize="9sp" />
        </LinearLayout>
            <TextView
            android:id="@+id/w_capacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
            <TextView
            android:id="@+id/w_cap_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="@color/text_label"
            android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
