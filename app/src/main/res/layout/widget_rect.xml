<?xml version="1.0" encoding="utf-8"?>
<!--
  3 x 2 widget (about 180 x 110 dp). Nothing is clickable except the refresh button (w_refresh).
  left  = four rings, 2 x 2: battery, current / RAM, CPU clock. Each shows a small label, a value and a small line.
  right = top apps (header with refresh button, 3 lines), storage bar, CPU and GPU temperatures
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_minimal"
    android:orientation="horizontal"
    android:paddingBottom="8dp"
    android:paddingEnd="9dp"
    android:paddingStart="8dp"
    android:paddingTop="8dp">

    <!-- Left: 2 x 2 rings -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">
                <ImageView
                    android:id="@+id/w_batt_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="BATT"
                        android:textColor="@color/text_label"
                        android:textSize="5.5sp" />
                    <TextView
                        android:id="@+id/w_battery_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="--"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />
                    <TextView
                        android:id="@+id/w_batt_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="--°"
                        android:textColor="@color/text_label"
                        android:textSize="6.5sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
        android:layout_marginStart="4dp">
                <ImageView
                    android:id="@+id/w_cur_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/w_cur_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="▼"
                        android:textColor="@color/text_label"
                        android:textSize="5sp" />
                    <TextView
                        android:id="@+id/w_cur_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="mA"
                        android:textColor="@color/text_label"
                        android:textSize="6sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">
                <ImageView
                    android:id="@+id/w_ram_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="RAM"
                        android:textColor="@color/text_label"
                        android:textSize="5.5sp" />
                    <TextView
                        android:id="@+id/w_ram_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="--"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />
                    <TextView
                        android:id="@+id/w_ram_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="of --"
                        android:textColor="@color/text_label"
                        android:textSize="5.5sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
        android:layout_marginStart="4dp">
                <ImageView
                    android:id="@+id/w_cpu_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="CPU"
                        android:textColor="@color/text_label"
                        android:textSize="5.5sp" />
                    <TextView
                        android:id="@+id/w_cpu_ghz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="GHz"
                        android:textColor="@color/text_label"
                        android:textSize="6sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="5dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="2dp"
        android:background="@color/divider" />

    <!-- Right: top apps, storage, temperatures -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header: label, age of the data, refresh button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="TOP"
                android:textColor="@color/text_label"
                android:textSize="6.5sp" />
            <TextView
                android:id="@+id/w_apps_age"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="6.5sp" />
            <FrameLayout
                android:id="@+id/w_refresh"
                android:layout_width="22dp"
                android:layout_height="17dp"
                android:background="@drawable/btn_refresh">
                <TextView
                    android:id="@+id/w_refresh_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="↻"
                    android:textColor="#FF07130E"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Shown instead of the three lines when there is no list yet (Tap refresh, Shizuku off ...) -->
        <TextView
            android:id="@+id/w_apps_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:text=""
            android:textColor="@color/text_label"
            android:textSize="8sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/w_app1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_app1_rank"
                android:layout_width="7dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="6.5sp" />
            <TextView
                android:id="@+id/w_app1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/w_app1_mb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_label"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_app2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_app2_rank"
                android:layout_width="7dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="6.5sp" />
            <TextView
                android:id="@+id/w_app2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/w_app2_mb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_label"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_app3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_app3_rank"
                android:layout_width="7dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="6.5sp" />
            <TextView
                android:id="@+id/w_app3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/w_app3_mb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_label"
                android:textSize="8sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Storage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="STO"
                android:textColor="@color/text_label"
                android:textSize="6sp" />
            <TextView
                android:id="@+id/w_sto_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/text_primary"
                android:textSize="7.5sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/w_sto_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progress="0"
            android:progressDrawable="@drawable/bar_thin_white" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/divider" />

        <!-- CPU and GPU temperatures -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="CPU"
                android:textColor="@color/text_label"
                android:textSize="6sp" />
            <TextView
                android:id="@+id/w_cpu_temp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="8.5sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="GPU"
                android:textColor="@color/text_label"
                android:textSize="6sp" />
            <TextView
                android:id="@+id/w_gpu_temp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="8.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
