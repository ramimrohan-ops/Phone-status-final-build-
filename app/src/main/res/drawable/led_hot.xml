<?xml version="1.0" encoding="utf-8"?>
<!-- LED dot: soft halo behind a solid core -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#55FF5470" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/led_hot" />
        </shape>
    </item>
</layer-list>
