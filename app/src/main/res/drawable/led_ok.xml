<?xml version="1.0" encoding="utf-8"?>
<!-- LED dot: soft halo behind a solid core -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#553DF5A7" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/led_ok" />
        </shape>
    </item>
</layer-list>
