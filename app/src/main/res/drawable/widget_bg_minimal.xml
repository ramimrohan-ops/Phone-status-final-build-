<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal widget card: near-black, a whisper of gradient, hairline border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#F507080D"
        android:startColor="#F5101320" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#14FFFFFF" />
</shape>
